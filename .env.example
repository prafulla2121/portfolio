# Copy to .env for `netlify dev`. Set the same names in Netlify: Site configuration > Environment variables.
# Generate both with: npm run hash-password -- "your long admin password"
# Wrap the hash in single quotes in .env because it contains $ signs.
ADMIN_PASSWORD_HASH='$2b$12$replace-with-output-of-hash-script'
# 32+ random characters. Changing it signs every admin out.
SESSION_SECRET=replace-with-48-random-bytes
